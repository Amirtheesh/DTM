# Server Configuration
PORT=5000
NODE_ENV=development

# Device Authentication
# The ESP32 must provide this key in the 'X-API-Key' HTTP header
DEVICE_API_KEY=sanitizer_secret_key_2026

# Timeout in seconds to consider ESP32 offline if no readings arrive
DEVICE_TIMEOUT_SECONDS=15

# Maximum number of data points to keep in memory for historical charts
MAX_HISTORY_ITEMS=100

# CORS settings (set to specific origin in production, or * for open LAN access)
CORS_ORIGIN=*
